{
  "allow_catalog_updates": false,
  "backend": "auto",
  "cache_limit_mb": 10240,
  "cache_max_age_days": 30,
  "check_updates_on_launch": true,
  "confirm_before_quit_with_jobs": true,
  "fallback": "ask",
  "ffmpeg_dir": null,
  "half_precision": false,
  "inspector_mode_advanced": false,
  "keep_failed_work": true,
  "language": "en",
  "last_export_folder": null,
  "low_disk_warning_mb": 5000,
  "max_concurrent_jobs": 1,
  "memory_limit_mb": 0,
  "motion": "system",
  "naming_template": "{name}_{task}",
  "notifications": true,
  "onboarding_complete": false,
  "output_dir": null,
  "performance": {
    "cpu_threads": 0,
    "device": "auto",
    "max_concurrent_jobs": 1,
    "memory_budget_mb": 8192,
    "memory_preset": "prioritize_app",
    "memory_pressure": "pause",
    "mode": "maximum",
    "oom_tile_fallback": true,
    "priority": "normal",
    "reserve_cpu_threads": 2,
    "vram_budget_mb": 0
  },
  "preview_max_height": 1080,
  "preview_seconds": 3.0,
  "quality_default": "balanced",
  "remember_last_export_folder": false,
  "segment_seconds": 10.0,
  "shortcuts": {
    "compare_toggle": "C",
    "export": "CmdOrCtrl+E",
    "frame_back": "ArrowLeft",
    "frame_forward": "ArrowRight",
    "open": "CmdOrCtrl+O",
    "play_pause": "Space",
    "preview": "CmdOrCtrl+P",
    "quick_export": "CmdOrCtrl+Shift+E",
    "redo": "CmdOrCtrl+Shift+Z",
    "set_in": "I",
    "set_out": "O",
    "settings": "CmdOrCtrl+Comma",
    "toggle_queue": "CmdOrCtrl+J",
    "undo": "CmdOrCtrl+Z",
    "zoom_100": "CmdOrCtrl+1",
    "zoom_fit": "CmdOrCtrl+0"
  },
  "stop_queue_on_error": false,
  "theme": "dark",
  "ui_scale": 1.0,
  "version": 2,
  "write_sidecar_report": false
}
